SET(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_CROSSCOMPILING 1)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

set(CMAKE_C_COMPILER $ENV{TOOLCHAIN_PREFIX}gcc)
set(CMAKE_CXX_COMPILER $ENV{TOOLCHAIN_PREFIX}g++)
set(CMAKE_ASM_COMPILER $ENV{TOOLCHAIN_PREFIX}gcc)
set(CMAKE_AR $ENV{TOOLCHAIN_PREFIX}ar)
set(CMAKE_RANLIB $ENV{TOOLCHAIN_PREFIX}ranlib)

SET(CMAKE_C_COMPILER_WORKS 1 CACHE INTERNAL "")
SET(CMAKE_CXX_COMPILER_WORKS 1 CACHE INTERNAL "")

set(ARDUINO_PICO_COMMON_FLAGS
    "-mcpu=cortex-m33 -mthumb -march=armv8-m.main+fp+dsp -mfloat-abi=softfp -mcmse -ffunction-sections -fdata-sections -fno-exceptions -Os -DARDUINO=10607 -DARDUINO_ARCH_RP2040 -DARDUINO_RASPBERRY_PI_PICO_2 -DBOARD_NAME=\\\"RASPBERRY_PI_PICO_2\\\" -DARDUINO_VARIANT=\\\"rpipico2\\\" -DF_CPU=150000000L -DUSBD_PID=0x000f -DUSBD_VID=0x2e8a -DUSBD_MAX_POWER_MA=250 -DPICO_FLASH_SIZE_BYTES=4194304 -DRCUTILS_LOG_MIN_SEVERITY=RCUTILS_LOG_MIN_SEVERITY_NONE"
    CACHE STRING "" FORCE)

set(CMAKE_C_FLAGS_INIT
    "-std=gnu11 ${ARDUINO_PICO_COMMON_FLAGS} -DCLOCK_MONOTONIC=0"
    CACHE STRING "" FORCE)
set(CMAKE_CXX_FLAGS_INIT
    "-std=gnu++17 ${ARDUINO_PICO_COMMON_FLAGS} -fno-rtti"
    CACHE STRING "" FORCE)

set(CMAKE_EXE_LINKER_FLAGS_INIT
    "-mcpu=cortex-m33 -mthumb -march=armv8-m.main+fp+dsp -mfloat-abi=softfp -mcmse"
    CACHE STRING "" FORCE)

set(__BIG_ENDIAN__ 0)
