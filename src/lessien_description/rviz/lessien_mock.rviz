# VISUAL NOT VERIFIED. UNVERIFIED model geometry remains mock-only.
Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Enabled: true
  Name: root
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: lessien_mock/odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Value: true
      Alpha: 0.5
      Cell Size: 0.1
      Plane: XY
      Plane Cell Count: 20
      Normal Cell Count: 0
      Reference Frame: <Fixed Frame>
      Color: 160; 160; 164
      Line Style:
        Value: Lines
        Line Width: 0.01
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Value: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /lessien_mock/robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
      TF Prefix: lessien_mock
      Update Interval: 0
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Show Names: true
      Show Axes: true
      Show Arrows: true
      Marker Scale: 0.15
      Frame Timeout: 15
      Frames:
        All Enabled: true
  # Viewing tools only: no goal/initial-pose/point publishers.
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Current View
      Distance: 1.2
      Focal Point:
        X: 0
        Y: 0
        Z: 0.06
      Near Clip Distance: 0.01
      Pitch: 0.6
      Yaw: 0.8
      Target Frame: lessien_mock/base_footprint
    Saved: ~
  Value: true
Window Geometry:
  Width: 1200
  Height: 800
  Hide Left Dock: false
  Hide Right Dock: false
